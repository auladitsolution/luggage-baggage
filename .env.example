# ==============================================================================
# লুমিনা লাগেজ অ্যান্ড ট্রাভেল - পরিবেশ ভ্যারিয়েবল টেমপ্লেট (.env.example)
# ==============================================================================
# অনুগ্রহ করে এই ফাইলটি কপি করে `.env.local` নামে সেভ করুন এবং আপনার আসল কী-সমূহ বসান।
# এই ফাইলে কোনো আসল পাসওয়ার্ড বা সিক্রেট কি লিখবেন না।
# ==============================================================================

# ১. ডাটাবেস সংযোগ (MongoDB Atlas
FIREBASE_PROJECT_ID=lumina-luggage-shop
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lumina-luggage-shop.iam.gserviceaccount.com
# প্রাইভেট কি-তে থাকা \n লাইনব্রেক সঠিকভাবে সংরক্ষণ করুন
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ৩. ফায়ারবেস ক্লায়েন্ট কনফিগারেশন (পাবলিক - গুগল সাইন-ইন এর জন্য)
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lumina-luggage-shop.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lumina-luggage-shop
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lumina-luggage-shop.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ৪. কাস্টম ইমেইল / এসএমটিপি কনফিগারেশন (ঐচ্ছিক - ভেরিফিকেশন কোড ইমেইলে পাঠানোর জন্য)
# Gmail App Password অথবা যেকোনো SMTP সার্ভার ব্যবহার করা যাবে
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM_NAME="Luggage & Baggage"